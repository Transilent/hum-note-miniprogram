.home-top { margin-bottom: 22rpx; }
.wordmark { gap: 14rpx; color: var(--accent); font-weight: 650; }
.brand-wave { display: flex; gap: 4rpx; align-items: center; height: 34rpx; }
.brand-wave view { width: 4rpx; height: 17rpx; background: currentColor; border-radius: 4rpx; }
.brand-wave view:nth-child(2), .brand-wave view:nth-child(4) { height: 25rpx; }
.brand-wave view:nth-child(3) { height: 33rpx; }
.home-heading { margin-bottom: 26rpx; }
.capture { background: var(--panel); border-radius: 38rpx; padding: 32rpx 34rpx; }
.capture-button { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; width: 100%; text-align: left; }
.capture-copy { min-width: 0; }
.capture-title { font-weight: 680; font-size: 44rpx; letter-spacing: -1rpx; }
.capture .caption { margin-top: 8rpx; }
.record-circle { display: grid; place-items: center; width: 104rpx; height: 104rpx; flex: 0 0 104rpx; border-radius: 50%; background: var(--accent); color: var(--on-accent); }
.capture-live .record-circle { color: var(--error); background: var(--error-bg); }
.stop-icon { width: 31rpx; height: 31rpx; border-radius: 7rpx; background: currentColor; }
.mic-icon { position: relative; width: 44rpx; height: 49rpx; }
.mic-body { position: absolute; width: 19rpx; height: 29rpx; top: 2rpx; left: 12rpx; border: 3rpx solid currentColor; border-radius: 15rpx; }
.mic-base { position: absolute; width: 33rpx; height: 20rpx; left: 5rpx; top: 19rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 22rpx 22rpx; }
.mic-base::after { content: ''; width: 3rpx; height: 9rpx; position: absolute; top: 17rpx; left: 12rpx; background: currentColor; }
.capture-progress { padding-bottom: 18rpx; }
.progress-number { color: var(--accent); }
.meter { height: 7rpx; border-radius: 12rpx; background: var(--line); margin: 17rpx 0 6rpx; overflow: hidden; }
.meter > view { background: var(--accent); height: 100%; border-radius: inherit; }
.live-meter { margin: 12rpx 12rpx 0; }
.live-meter > view { background: var(--error); }
.pending-entry { margin-top: 22rpx; width: 100%; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; background: var(--panel); }
.pending-list { max-height: 56vh; }
.pending-row { min-height: 59px; padding: 10rpx 0; border-top: 1rpx solid var(--line); }
.pending-remove { color: var(--error); }
.idea-list { background: var(--surface); border-radius: 30rpx; padding: 0 22rpx; }
.idea-row { display: flex; align-items: center; gap: 22rpx; min-height: 62px; padding: 11rpx 0; width: 100%; text-align: left; border-radius: 0; }
.idea-row + .idea-row { border-top: 1rpx solid var(--line); }
.idea-main { flex: 1; min-width: 0; }
.idea-title { width: 100%; font-size: 30rpx; font-weight: 620; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.idea-arrow { color: var(--muted); font-size: 39rpx; padding-right: 3rpx; }
.mini-melody { flex: 0 0 76rpx; height: 67rpx; border-radius: 15rpx; background: var(--panel); display: flex; align-items: center; justify-content: center; gap: 3rpx; padding: 0 9rpx; overflow: hidden; }
.mini-melody view { background: var(--accent); width: 4rpx; border-radius: 4rpx; flex-shrink: 1; }
.library-more { margin: 10rpx auto 0; display: flex; }
.home-compose { margin-top: 10rpx; }
.recognition-modes { display: flex; gap: 5rpx; padding: 5rpx; margin: 8rpx 0 12rpx; border-radius: 24rpx; background: var(--panel); }
.recognition-modes button { flex: 1; border-radius: 20rpx; color: var(--muted); }
.recognition-modes .mode-selected { font-weight: 640; color: var(--accent); background: var(--surface); }
