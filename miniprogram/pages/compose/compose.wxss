.compose-heading { margin-bottom: 10rpx; }
.bpm-badge { flex: 0 0 auto; padding: 13rpx 16rpx; border-radius: 22rpx; background: var(--panel); color: var(--accent); font-weight: 640; }
.bpm-badge text { font-size: 21rpx; font-weight: 500; }
.source-row { gap: 12rpx; min-height: 44px; }
.source-title { color: var(--accent); font-weight: 600; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.source-row .caption { flex-shrink: 0; white-space: nowrap; }
.empty-compose { padding: 16rpx 0 0; }
.empty-compose .primary { margin: 22rpx 0 12rpx; }
.preset-grid { display: flex; gap: 9rpx; flex-wrap: wrap; margin: 18rpx 0 12rpx; }
.preset-button, .mode-buttons button, .choices button { display: flex; align-items: center; justify-content: center; }
.preset-button { flex-shrink: 0; padding: 0 20rpx; background: var(--panel); color: var(--accent); }
.preset-active { color: var(--on-accent); background: var(--accent); }
.preset-more { padding-left: 12rpx; }
.preset-tip { margin-bottom: 22rpx; }
.mode-buttons { display: flex; gap: 6rpx; padding: 5rpx; background: var(--panel); border-radius: 26rpx; }
.mode-buttons button { flex: 1; color: var(--muted); }
.mode-buttons .mode-active { background: var(--surface); color: var(--ink); font-weight: 650; }
.parameter-block { margin-top: 18rpx; }
.choices { display: flex; flex-wrap: wrap; gap: 7rpx; margin: 6rpx 0 10rpx; }
.choices button { min-width: 44px; padding: 0 12rpx; background: var(--surface); color: var(--muted); font-size: 25rpx; }
.choices .choice-active { color: var(--accent); background: var(--panel); font-weight: 650; }
.repeat-label { margin-top: 13rpx; }
.compare-stack { margin-top: 20rpx; }
.compare-label { gap: 9rpx; }
.compare-title { font-weight: 650; }
.compare-label .caption { font-size: 23rpx; }
.contour { position: relative; overflow: hidden; height: 111rpx; border-radius: 21rpx; background: var(--panel); }
.contour-note { height: 8rpx; border-radius: 8rpx; position: absolute; background: var(--accent); }
.source-note { opacity: .72; }
.join-line { position: absolute; height: 100%; border-left: 1rpx dashed var(--accent); opacity: .5; }
.result-heading { margin-top: 10rpx; }
.compose-footer { margin-top: 24rpx; display: flex; gap: 14rpx; align-items: center; }
.compose-footer button { flex: 1; min-width: 0; padding-inline: 12rpx; }
.compose-bottom { margin-top: 9rpx; }
.tone-picker { min-height: 44px; display: flex; align-items: center; }
.composition-error { border-radius: 20rpx; padding: 17rpx 20rpx; color: var(--error); background: var(--error-bg); font-size: 26rpx; }
.composition-error button { color: var(--error); display: flex; }
