<view class="page compose-page">
  <view class="compose-heading between">
    <view class="page-title">发展旋律</view>
    <view wx:if="{{hasSource}}" class="bpm-badge tabular">{{bpm}} <text>BPM</text></view>
  </view>
  <view wx:if="{{!hasSource}}" class="empty-compose">
    <view class="caption">{{error || '录一段哼唱，或用示例试试旋律变形。'}}</view>
    <button id="compose-demo" class="primary" bindtap="useDemo" disabled="{{creatingDemo}}" loading="{{creatingDemo}}">用示例创作</button>
    <button id="back-empty-composer" class="text-button" bindtap="backToEditor">返回</button>
  </view>
  <block wx:else>
    <picker id="source-picker" range="{{sources}}" range-key="title" value="{{sourceIndex}}" bindchange="chooseSource" disabled="{{saving || applying}}">
      <view class="source-row between"><text class="source-title">{{sourceTitle}}</text><text class="caption">换一段 ›</text></view>
    </picker>
    <view class="preset-grid" aria-label="旋律变形">
      <block wx:for="{{presets}}" wx:key="id">
        <button wx:if="{{item.common || morePresets || presetId === item.id}}" id="preset-{{item.id}}" class="preset-button {{presetId === item.id ? 'preset-active' : ''}}"
          data-id="{{item.id}}" bindtap="choosePreset" disabled="{{saving || applying}}">{{item.title}}</button>
      </block>
      <button id="more-presets" class="text-button preset-more" bindtap="togglePresets">{{morePresets ? '收起' : '更多 ›'}}</button>
    </view>
    <view class="caption preset-tip">{{activePreset.tip}}{{presetId === 'inversion' || presetId === 'retrograde-inversion' ? ' 镜像中心为 ' + anchorName + '。' : ''}}</view>
    <view class="mode-buttons">
      <button id="mode-append" data-mode="append" bindtap="chooseMode" class="{{mode === 'append' ? 'mode-active' : ''}}">接在原句后</button>
      <button id="mode-replace" data-mode="replace" bindtap="chooseMode" class="{{mode === 'replace' ? 'mode-active' : ''}}">只保留变形</button>
    </view>
    <view wx:if="{{mode === 'append'}}" class="parameter-block">
      <view class="caption">两段间留白 · 拍</view>
      <view class="choices"><button wx:for="{{gaps}}" wx:key="*this" data-key="gap" data-value="{{item}}" bindtap="chooseParameter" class="{{gap === item ? 'choice-active' : ''}}">{{item}}</button></view>
    </view>
    <view wx:if="{{presetId === 'transpose'}}" class="parameter-block">
      <view class="caption">升降半音</view>
      <view class="choices"><button wx:for="{{transpositions}}" wx:key="*this" data-key="transpose" data-value="{{item}}" bindtap="chooseParameter" class="{{transpose === item ? 'choice-active' : ''}}">{{item > 0 ? '+' : ''}}{{item}}</button></view>
    </view>
    <view wx:if="{{presetId === 'fragment'}}" class="parameter-block">
      <view class="caption">开头音符数</view>
      <view class="choices"><button wx:for="{{fragmentSizes}}" wx:key="*this" data-key="fragmentSize" data-value="{{item}}" bindtap="chooseParameter" class="{{fragmentSize === item ? 'choice-active' : ''}}">{{item}}</button></view>
      <view class="caption repeat-label">重复次数</view>
      <view class="choices"><button wx:for="{{repeatCounts}}" wx:key="*this" data-key="repeatCount" data-value="{{item}}" bindtap="chooseParameter" class="{{repeatCount === item ? 'choice-active' : ''}}">{{item}}</button></view>
    </view>

    <view class="compare-stack">
      <view class="between">
        <view class="row compare-label"><text class="compare-title">原旋律</text><text class="caption tabular">{{sourceDuration}} 秒</text></view>
        <button id="preview-source" class="text-button" data-mode="source" bindtap="preview">{{playPreparing && playback === 'source' ? '准备中 · 取消' : playing && playback === 'source' ? '停止 · ' + playTime : '试听原句'}}</button>
      </view>
      <view class="contour"><view wx:for="{{sourceBars}}" wx:key="id" class="contour-note source-note" style="left: {{item.x}}%; top: {{item.y}}rpx; width: {{item.width}}%;"></view></view>
      <view class="between result-heading">
        <view class="row compare-label"><text class="compare-title">创作结果</text><text wx:if="{{!error}}" class="caption tabular">{{resultDuration}} 秒</text></view>
        <button id="preview-result" class="text-button" data-mode="result" bindtap="preview" disabled="{{!!error}}">{{playPreparing && playback === 'result' ? '准备中 · 取消' : playing && playback === 'result' ? '停止 · ' + playTime : '试听结果'}}</button>
      </view>
      <view wx:if="{{!error}}" class="contour">
        <view wx:for="{{resultBars}}" wx:key="id" class="contour-note" style="left: {{item.x}}%; top: {{item.y}}rpx; width: {{item.width}}%;"></view>
        <view wx:if="{{joinX > 0}}" class="join-line" style="left: {{joinX}}%;"></view>
      </view>
      <view wx:if="{{error}}" id="composition-error" class="composition-error">{{error}}
        <button class="text-button" bindtap="backToEditor">回音符编辑</button>
      </view>
    </view>
    <view class="compose-footer">
      <button wx:if="{{canApplyToSource}}" id="apply-composition" class="primary" bindtap="applyToSource" disabled="{{!!error || saving || applying}}" loading="{{applying}}">应用到当前旋律</button>
      <button id="save-composition" class="{{canApplyToSource ? 'secondary' : 'primary'}}" bindtap="saveAsNew" disabled="{{!!error || saving || applying}}" loading="{{saving}}">另存灵感</button>
    </view>
    <view class="between compose-bottom">
      <button id="back-editor" class="text-button" bindtap="backToEditor">回音符编辑</button>
      <picker range="{{toneNames}}" value="{{toneIndex}}" bindchange="changeTone"><view class="tone-picker caption">{{toneNames[toneIndex]}} ›</view></picker>
    </view>
  </block>
</view>
