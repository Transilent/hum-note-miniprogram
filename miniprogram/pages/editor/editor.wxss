.editor { padding-top: 20rpx; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.editor-with-original { padding-bottom: calc(234rpx + env(safe-area-inset-bottom)); }
.editor-topbar { display: flex; align-items: center; gap: 16rpx; justify-content: space-between; }
.editor-title-group { flex: 1; min-width: 0; }
.title-input { width: 100%; min-height: 43px; font-size: 54rpx; font-weight: 700; line-height: 1.16; letter-spacing: -1.5rpx; color: var(--ink); }
.editor-meta { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.save-conflict { color: var(--error); }
.bpm-control { height: 44px; display: flex; align-items: center; padding: 0 14rpx; border-radius: 23rpx; background: var(--panel); color: var(--accent); flex-shrink: 0; font-size: 22rpx; gap: 5rpx; }
.bpm-control input { width: 75rpx; text-align: center; font-size: 38rpx; font-weight: 650; color: var(--accent); }
.recognition-row { margin: 4rpx 0; }
.roll-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 5rpx; margin: 8rpx 0 3rpx; }
.roll-buttons { display: flex; align-items: center; }
.tool-icon { flex: 0 0 auto; color: var(--accent); font-size: 37rpx; width: 44px; display: flex; align-items: center; justify-content: center; }
.tools-button { font-weight: 680; font-size: 33rpx; }
.zoom-control { font-size: 24rpx; color: var(--muted); white-space: nowrap; }
.zoom-control .tool-icon { font-size: 30rpx; }
.list-button { margin-left: auto; padding: 0 4rpx; }
.roll-card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; overflow: hidden; }
.roll-ruler { height: 45rpx; position: relative; overflow: hidden; background: var(--surface); border-bottom: 1rpx solid var(--line); }
.ruler-track { position: relative; height: 100%; }
.ruler-tick { position: absolute; height: 100%; padding: 4rpx 0 0 7rpx; color: var(--muted); border-left: 1rpx solid var(--line); font-size: 22rpx; }
.bar-tick { color: var(--accent); font-weight: 680; }
.ruler-label { width: 68rpx; position: absolute; inset: 0 auto 0 0; background: var(--surface); color: var(--muted); font-size: 22rpx; display: flex; align-items: center; justify-content: center; border-right: 1rpx solid var(--line); }
.roll-scroll { width: 100%; }
.roll-inner { position: relative; isolation: isolate; }
.pitch-row { position: absolute; width: 100%; height: 44rpx; border-bottom: 1rpx solid var(--line); }
.black-row { background: var(--panel); }
.pitch-name { position: absolute; top: 0; bottom: 0; left: 0; width: 68rpx; transform: translateX(var(--key-shift, 0px)); z-index: 5; padding-left: 11rpx; line-height: 43rpx; border-right: 1rpx solid var(--line); font-size: 21rpx; color: var(--muted); background: var(--surface); }
.black-row .pitch-name { background: var(--panel); }
.roll-grid { position: absolute; inset: 0; left: 68rpx; pointer-events: none; background-image: linear-gradient(to right, var(--line) 2rpx, transparent 2rpx), linear-gradient(to right, var(--line) 1rpx, transparent 1rpx); opacity: .78; }
.roll-note { position: absolute; height: 36rpx; min-width: 10rpx; background: var(--note); border-radius: 10rpx; color: var(--ink); line-height: 36rpx; text-align: center; font-size: 21rpx; z-index: 2; }
.roll-note > text { display: block; white-space: nowrap; overflow: hidden; }
.uncertain-note { box-shadow: inset 0 0 0 1rpx var(--accent); }
.selected-note { background: var(--accent); color: var(--on-accent); z-index: 3; }
.overlap-note { background: var(--error-bg); color: var(--error); box-shadow: inset 0 0 0 2rpx var(--error); }
.note-handle { position: absolute; inset: -4rpx -10rpx -4rpx auto; width: 30rpx; display: flex; align-items: center; justify-content: center; }
.note-handle::after { content: ''; height: 22rpx; width: 5rpx; border-radius: 3rpx; background: currentColor; }
.playhead, .ruler-cursor { position: absolute; height: 100%; left: 0; top: 0; width: 2rpx; background: var(--accent); pointer-events: none; z-index: 4; }
.ruler-cursor::after { content: ''; display: block; position: absolute; bottom: 0; left: -5rpx; width: 12rpx; height: 10rpx; background: var(--accent); border-radius: 3rpx; }
.roll-help { gap: 6rpx; }
.roll-help .caption { font-size: 23rpx; }
.roll-help .text-button { min-height: 38px; }
.overlap-warning { padding: 17rpx 19rpx; margin-bottom: 14rpx; border-radius: 22rpx; color: var(--error); background: var(--error-bg); font-size: 26rpx; }
.overlap-warning text { font-size: 23rpx; }
.inspector-header { gap: 4rpx; margin-bottom: 4rpx; }
.selected-note-label { font-weight: 650; font-size: 28rpx; color: var(--accent); }
.inspector .text-button { font-size: 24rpx; }
.note-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13rpx; }
.note-fields input { margin-top: 6rpx; width: 100%; height: 44px; min-height: 44px; padding: 0 14rpx; border: 1rpx solid var(--line); border-radius: 19rpx; background: var(--surface); color: var(--ink); font-size: 32rpx; }
.selection-hint { margin-top: 12rpx; }
.expanded-selection { gap: 8rpx; font-size: 26rpx; color: var(--accent); }
.editor-expanded .title-input { font-size: 40rpx; }
.editor-expanded .editor-meta { display: none; }
.transport-dock { position: fixed; left: 0; right: 0; bottom: 0; border-top: 1rpx solid var(--line); padding: 12rpx 36rpx calc(12rpx + env(safe-area-inset-bottom)); z-index: 12; background: var(--page); }
.transport-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.playback-button { width: 106rpx; flex-shrink: 0; height: 44px; padding: 0; }
.play-triangle { width: 0; height: 0; border-left: 22rpx solid currentColor; border-top: 13rpx solid transparent; border-bottom: 13rpx solid transparent; margin-left: 5rpx; }
.stop-square { width: 22rpx; height: 22rpx; border-radius: 4rpx; background: currentColor; }
.prepare-spinner { width: 22rpx; height: 22rpx; border: 3rpx solid currentColor; border-right-color: transparent; border-radius: 20rpx; }
.source-switch { display: flex; gap: 4rpx; padding: 4rpx; background: var(--panel); border-radius: 24rpx; }
.source-switch button { display: flex; justify-content: center; align-items: center; min-width: 44px; padding: 0 14rpx; font-size: 26rpx; color: var(--muted); }
.source-switch .source-active { background: var(--surface); color: var(--ink); font-weight: 650; border-radius: 19rpx; }
.transport-time { text-align: center; font-size: 22rpx; }
.share-button { color: var(--accent); font-weight: 650; }
.original-scrub { display: flex; align-items: center; }
.original-scrub slider { flex: 1; margin: 8rpx 14rpx; }
.note-list-scroll { height: 264px; max-height: 55vh; }
.note-list-header, .note-list-row { display: grid; grid-template-columns: 1.16fr .9fr 1fr 1.15fr; align-items: center; gap: 6rpx; padding: 0 13rpx; text-align: left; }
.note-list-header { height: 58rpx; color: var(--muted); font-size: 23rpx; }
.note-list-row { height: 44px; min-height: 44px; width: 100%; color: var(--ink); border-radius: 0; border-top: 1rpx solid var(--line); font-size: 26rpx; font-variant-numeric: tabular-nums; }
.active-row { background: var(--panel); }
.overlap-tag, .destructive { color: var(--error); }
.overlap-tag { font-size: 20rpx; }
.list-hint, .share-hint { padding-bottom: 10rpx; }
.editor-tools-list { max-height: 62vh; }
.group-title { font-weight: 620; font-size: 28rpx; padding: 14rpx 0 5rpx; }
.adjust-row { display: grid; grid-template-columns: 1fr 120rpx 120rpx; align-items: center; gap: 10rpx; margin-top: 6rpx; font-size: 27rpx; }
.adjust-row button, .duration-presets button { display: flex; align-items: center; justify-content: center; background: var(--panel); color: var(--accent); }
.duration-presets { display: flex; gap: 7rpx; margin-top: 12rpx; }
.duration-presets button { flex: 1; min-width: 0; font-size: 23rpx; }
.tool-line { display: flex; justify-content: space-between; align-items: center; gap: 8rpx; }
.tone-row { border-top: 1rpx solid var(--line); min-height: 44px; padding: 0 8rpx; font-size: 27rpx; }
.engine-caption { margin: 10rpx 8rpx 0; }
.file-option { width: 100%; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--line); border-radius: 0; padding: 0 5rpx; }
.file-name { margin-top: 12rpx; overflow-wrap: anywhere; font-weight: 600; }
@media (max-width: 355px) {
  .roll-toolbar { gap: 2rpx; flex-wrap: wrap; }
  .zoom-control .tool-icon { width: 39px; }
  .title-input { font-size: 49rpx; }
}
