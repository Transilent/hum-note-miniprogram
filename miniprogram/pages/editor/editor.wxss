.editor { padding-top: 24rpx; }
.editor-page-tabs { display: flex; align-items: center; background: #eceee5; border-radius: 17rpx; padding: 5rpx; margin: 0 0 27rpx; }
.editor-page-tabs view, .editor-page-tabs button { width: 50%; text-align: center; padding: 13rpx 16rpx; font-size: 25rpx; background: transparent; color: #7e8b72; border-radius: 13rpx; }
.editor-page-tabs .current-tab { color: #365e48; background: #fffefb; font-weight: 600; }
.editor-expanded .editor-page-tabs { visibility: hidden; }
.audio-export-button { width: 100%; margin-top: 24rpx; font-size: 28rpx; padding: 24rpx; }
.editor-topbar { position: sticky; top: 0; z-index: 20; background: #f7f5f0; padding: 8rpx 0 12rpx; margin-bottom: 18rpx; }
.editor-topbar .save-state { max-width: 400rpx; }
.editor-expanded .editor-topbar { position: fixed; top: 0; left: 0; right: 0; padding: 8rpx 24rpx; height: 84rpx; z-index: 90; margin: 0; }
.save-state { font-size: 21rpx; color: #7e9673; }
.save-state.save-conflict { color: #b36c51; }
.overlap-warning { background: #faeee5; border: 1rpx solid #e6c9b7; border-radius: 19rpx; padding: 21rpx 24rpx; margin-top: 18rpx; color: #a76246; font-size: 26rpx; line-height: 1.7; }
.overlap-warning text { display: block; font-size: 21rpx; color: #b4866f; }
.title-input { height: 83rpx; margin-top: 19rpx; font-size: 41rpx; font-weight: 600; }
.subtitle-row { margin-bottom: 26rpx; }
.transport { padding: 26rpx; }
.play-button { height: 81rpx; width: 81rpx; border-radius: 50%; background: #365e48; display: flex; align-items: center; justify-content: center; }
.play-triangle { border-top: 13rpx solid transparent; border-bottom: 13rpx solid transparent; border-left: 20rpx solid #fff; margin-left: 6rpx; width: 0; height: 0; }
.pause-square { width: 22rpx; height: 22rpx; border-radius: 3rpx; background: #fff; }
.transport-copy { margin-left: 22rpx; font-size: 28rpx; font-weight: 500; }
.transport-copy text { display: block; color: #959c8b; margin-top: 7rpx; font-size: 21rpx; font-weight: 400; }
.tone-picker { font-size: 23rpx; color: #69805c; padding: 13rpx 16rpx; background: #f0f2e9; border-radius: 12rpx; }
.original-button { margin-top: 24rpx; background: #f4f3ed; color: #7c8872; padding: 15rpx; font-size: 24rpx; }
.tool-icon { background: transparent; color: #617758; width: 57rpx; height: 45rpx; font-size: 36rpx; line-height: 40rpx; }
.roll-card { overflow: hidden; padding-top: 8rpx; }
.roll-scroll { width: 100%; }
.roll-inner { position: relative; background: #fffefb; }
.pitch-row { position: absolute; height: 44rpx; border-bottom: 1rpx solid #eeeee5; }
.black-row { background: #f6f6ef; }
.pitch-name { width: 61rpx; text-align: right; padding-right: 10rpx; font-size: 20rpx; color: #7f8878; display: block; height: 44rpx; line-height: 44rpx; border-right: 1rpx solid #dedfd1; }
.beat-line { position: absolute; top: 0; width: 1rpx; border-left: 1rpx solid #efefe5; pointer-events: none; }
.bar-line { border-color: #dadfcf; }
.beat-label { position: absolute; top: 8rpx; left: 6rpx; font-size: 19rpx; color: #9ca68c; }
.roll-note { position: absolute; height: 36rpx; min-width: 10rpx; background: #b8ca9f; border: 1rpx solid #a7bb8d; border-radius: 7rpx; color: #fff; overflow: visible; z-index: 2; }
.roll-note text { font-size: 20rpx; line-height: 32rpx; padding-left: 7rpx; vertical-align: top; }
.selected-note { background: #365e48; border-color: #284c38; z-index: 4; box-shadow: 0 0 0 3rpx rgba(54,94,72,.13); }
.uncertain-note { border-style: dashed; }
.roll-note.overlap-note { background: #ce9275; border-color: #b97457; }
.selected-note.overlap-note { background: #a65b43; border-color: #8c4532; box-shadow: 0 0 0 3rpx rgba(166,91,67,.15); }
.note-handle { position: absolute; right: -8rpx; top: -4rpx; bottom: -4rpx; width: 20rpx; z-index: 5; }
.note-handle::after { content: ''; position: absolute; top: 12rpx; right: 10rpx; width: 3rpx; height: 20rpx; background: #fff; opacity: .8; border-radius: 3rpx; }
.playhead { position: absolute; top: 0; left: 0; width: 3rpx; background: #c48c68; z-index: 6; pointer-events: none; transition: transform 33ms linear; will-change: transform; }
.roll-toolbar { margin-bottom: 12rpx; color: #7e8b72; font-size: 23rpx; }
.roll-toolbar text { min-width: 86rpx; text-align: center; }
.zoom-button { width: 55rpx; height: 48rpx; line-height: 48rpx; background: #e9eee2; color: #536f4a; font-size: 27rpx; }
.expand-button, .roll-play { padding: 9rpx 20rpx; background: #e7eddf; color: #365e48; font-size: 23rpx; border-radius: 12rpx; }
.expand-button { margin-left: 14rpx; }
.expanded-workspace { position: fixed; top: 84rpx; left: 0; right: 0; bottom: 0; z-index: 80; background: #f7f5f0; padding: 18rpx 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); overflow-y: auto; }
.expanded-workspace .roll-heading { margin: 0 0 14rpx; }
.expanded-selection { padding: 16rpx 4rpx 0; }
.expanded-selection .caption { font-size: 21rpx; }
.expanded-selection .text-button { flex-shrink: 0; }
.roll-hint { padding: 19rpx 15rpx; background: #f4f4eb; color: #9ba38e; text-align: center; font-size: 20rpx; border-top: 1rpx solid #e9eadf; }
.roll-hint view { margin-top: 6rpx; font-size: 18rpx; opacity: .85; }
.note-edit { padding: 25rpx 26rpx 0; margin-top: 22rpx; }
.selected-badge { background: #e8eedf; color: #365e48; width: 80rpx; height: 80rpx; border-radius: 19rpx; font-size: 30rpx; font-weight: 600; text-align: center; line-height: 80rpx; margin-right: 19rpx; }
.edit-title { font-size: 27rpx; font-weight: 500; }
.control-row { display: flex; align-items: center; justify-content: space-between; margin-top: 27rpx; }
.control-label { font-size: 26rpx; color: #858e78; }
.pitch-controls, .duration-controls, .start-controls { display: flex; align-items: center; justify-content: space-between; width: 390rpx; }
.step-button { background: #f0f1e8; width: 67rpx; height: 62rpx; line-height: 62rpx; color: #627b57; font-size: 30rpx; border-radius: 14rpx; flex-shrink: 0; }
.pitch-value { color: #365e48; text-align: center; font-size: 29rpx; font-weight: 600; line-height: 1.2; }
.pitch-value text { display: block; font-size: 18rpx; color: #a1a88f; font-weight: 400; margin-top: 5rpx; }
.duration-controls input, .start-controls input { width: 140rpx; height: 60rpx; text-align: center; font-size: 28rpx; color: #365e48; }
.start-controls input { border: 1rpx solid #dfe6d2; border-radius: 11rpx; background: #f2f5eb; }
.position-hint { margin-top: 14rpx; font-size: 20rpx; color: #9ba58b; text-align: right; }
.unit { font-size: 23rpx; color: #a0a78f; margin-left: -45rpx; }
.duration-presets { display: flex; justify-content: space-between; margin-top: 25rpx; }
.duration-presets button { background: #f4f4ec; color: #8c957d; font-size: 24rpx; padding: 12rpx 22rpx; border: 1rpx solid #eeeee4; border-radius: 12rpx; }
.duration-presets .chosen { background: #e3ecda; color: #4f7043; border-color: #bccdac; }
.note-edit-footer { margin-top: 25rpx; border-top: 1rpx solid #f0efe5; padding: 18rpx 0; }
.note-edit-footer > text { font-size: 19rpx; color: #a2a88f; }
.delete-note { background: transparent; color: #b38670; font-size: 22rpx; padding: 6rpx 0 6rpx 12rpx; }
.global-controls { padding: 27rpx; }
.bpm-control { display: flex; align-items: baseline; color: #8d977c; background: #eef2e6; border: 1rpx solid #dce4ce; border-radius: 13rpx; padding: 8rpx 12rpx; }
.bpm-control input { width: 93rpx; height: 50rpx; text-align: center; font-size: 33rpx; font-weight: 600; color: #365e48; }
.bpm-control text { font-size: 19rpx; }
.global-controls .caption { font-size: 21rpx; margin-top: 7rpx; }
.global-actions { display: flex; }
.global-actions button { flex: 1; background: #f0f2e8; color: #718460; padding: 17rpx 0; font-size: 24rpx; margin-right: 14rpx; border-radius: 13rpx; }
.global-actions button:last-child { margin-right: 0; }
.global-controls .small-hint { font-size: 19rpx; margin-top: 17rpx; }
.note-list { overflow: hidden; }
.list-instructions { color: #7c8870; font-size: 23rpx; line-height: 1.9; margin: -8rpx 0 22rpx; }
.note-edit { scroll-margin-top: 92rpx; }
.note-list-header, .note-list-row { display: flex; align-items: center; }
.note-list-header { background: #edeee3; color: #929b83; font-size: 21rpx; height: 60rpx; }
.note-list-header text, .note-list-row > text { width: 25%; text-align: center; }
.note-list-scroll { max-height: 390rpx; height: 390rpx; }
.note-list-row { height: 65rpx; font-size: 25rpx; color: #839078; border-bottom: 1rpx solid #f0f0e7; }
.active-row { background: #e9efdf; color: #3e663e; }
.note-list-row.overlap-row { background: #faeee5; color: #a96d51; }
.note-list-row.active-row.overlap-row { background: #f3dfd1; color: #8d4c34; }
.overlap-tag { font-size: 18rpx; }
.uncertain-dot { color: #c58d59; }
.editor-tip { font-size: 21rpx; color: #9ba28d; margin: 25rpx 0 33rpx; text-align: center; line-height: 1.9; }
.export-button { width: 100%; display: flex; align-items: center; justify-content: center; padding: 26rpx; font-size: 29rpx; }
.export-button text { margin-left: 17rpx; font-size: 34rpx; }
.export-button.export-conflict { background: #b3836c; }
.export-caption { text-align: center; margin-top: 17rpx; font-size: 21rpx; color: #a2a88e; }
.export-file-icon { width: 91rpx; height: 91rpx; background: #e7eedb; color: #618349; border-radius: 23rpx; text-align: center; line-height: 91rpx; font-size: 52rpx; margin-bottom: 27rpx; }
.file-name { color: #4b6643; word-break: break-all; font-size: 27rpx; margin-bottom: 12rpx; }
.export-copy { margin-top: 25rpx; margin-bottom: 15rpx; }
.dev-hint { background: #f2f0e4; padding: 19rpx; border-radius: 15rpx; font-size: 22rpx; line-height: 1.8; color: #9b926d; }
