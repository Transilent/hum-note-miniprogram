<view class="page editor {{expanded ? 'editor-expanded' : ''}}" wx:if="{{notes.length}}">
  <view class="editor-topbar between"><text class="save-state {{hasOverlaps ? 'save-conflict' : ''}}" bindtap="saveNow">{{saveState}}</text><view class="bpm-control"><input id="bpm-input" type="number" value="{{bpm}}" bindblur="changeBpm" bindconfirm="changeBpm" /><text>BPM</text></view></view>
  <view class="editor-page-tabs"><view class="current-tab">音符编辑</view><button id="open-composer" bindtap="openComposer">旋律创作 ↗</button></view>
  <view class="eyebrow">A LITTLE MELODY, YOURS.</view>
  <input id="idea-title" class="title-input" value="{{title}}" maxlength="40" bindinput="changeTitle" placeholder="给这段灵感起个名字" />
  <view class="between subtitle-row"><text class="caption">{{notes.length}} 个音符 · {{durationLabel}} 秒</text><view class="pill">{{isDemo ? '示例旋律' : '我的哼唱'}}</view></view>

  <view class="transport card"><view class="between"><view class="row"><button id="play-button" class="play-button" bindtap="play"><view wx:if="{{playing && playbackMode === 'melody'}}" class="pause-square"></view><view wx:else class="play-triangle"></view></button><view class="transport-copy"><view>{{playing && playbackMode === 'melody' ? '正在播放旋律' : '听听这段旋律'}}</view><text>{{playing && playbackMode === 'melody' ? playTime : '每一次改动，都能听见'}}</text></view></view><picker range="{{toneNames}}" value="{{toneIndex}}" bindchange="changeTone"><view class="tone-picker">{{toneNames[toneIndex]}}⌄</view></picker></view><button wx:if="{{source}}" id="original-button" class="original-button" bindtap="playOriginal">{{playing && playbackMode === 'original' ? '■ 停止原始录音' : '♫ 对比原始哼唱'}}</button></view>

  <view id="roll-workspace" class="roll-workspace {{expanded ? 'expanded-workspace' : ''}}">
  <view class="section-heading roll-heading"><text class="section-title">钢琴卷帘</text><view class="row"><button id="undo-button" class="tool-icon" disabled="{{!canUndo}}" bindtap="undo">↶</button><button id="redo-button" class="tool-icon" disabled="{{!canRedo}}" bindtap="redo">↷</button><button id="expand-roll" class="expand-button" bindtap="toggleExpanded">{{expanded ? '收起' : '展开编辑'}}</button></view></view>
  <view class="roll-toolbar between"><view class="row"><button id="zoom-out" class="zoom-button" data-delta="-0.25" disabled="{{zoom <= 0.5}}" bindtap="changeZoom">−</button><text>{{zoom * 100}}%</text><button id="zoom-in" class="zoom-button" data-delta="0.25" disabled="{{zoom >= 2}}" bindtap="changeZoom">＋</button></view><button id="roll-play" class="roll-play" bindtap="play">{{playing && playbackMode === 'melody' ? '■ 停止' : '▶ 试听'}}</button></view>
  <view class="roll-card card"><scroll-view id="piano-roll" class="roll-scroll" scroll-x scroll-y enhanced show-scrollbar="{{true}}" scroll-left="{{rollScrollLeft}}" scroll-top="{{rollScrollTop}}" bindscroll="onRollScroll" style="height: {{rollHeight}}rpx;"><view class="roll-inner" style="width: {{rollWidth}}rpx; height: {{rollContentHeight}}rpx;">
    <view wx:for="{{rows}}" wx:key="midi" class="pitch-row {{item.black ? 'black-row' : ''}}" style="top: {{item.y}}rpx; width: {{rollWidth}}rpx;"><text class="pitch-name">{{item.name}}</text></view>
    <view wx:for="{{ticks}}" wx:key="beat" class="beat-line {{item.bar ? 'bar-line' : ''}}" style="left: {{item.x}}rpx; height: {{rollContentHeight}}rpx;"><text class="beat-label">{{item.label}}</text></view>
    <view wx:for="{{notes}}" wx:key="id" class="roll-note {{item.selected ? 'selected-note' : ''}} {{item.uncertain ? 'uncertain-note' : ''}} {{item.overlapping ? 'overlap-note' : ''}}" style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.width}}rpx;" data-id="{{item.id}}" data-mode="move" bindtap="selectNote" bindtouchstart="onNoteTouchStart" catchtouchmove="onNoteTouchMove" bindtouchend="onNoteTouchEnd" bindtouchcancel="onNoteTouchEnd"><text wx:if="{{item.width > 38}}">{{item.label}}</text><view wx:if="{{item.selected && item.width >= 20}}" class="note-handle" data-id="{{item.id}}" data-mode="duration" catchtouchstart="onNoteTouchStart" catchtouchmove="onNoteTouchMove" catchtouchend="onNoteTouchEnd"></view></view>
    <view wx:if="{{playing && playbackMode === 'melody'}}" class="playhead" style="transform: translateX({{playhead}}rpx); height: {{rollContentHeight}}rpx;"></view>
  </view></scroll-view><view class="roll-hint">左右移起点 · 上下改音高 · 拖右侧边缘改时值<view>横移吸附 1/8 拍，也可输入起始拍精调</view></view></view>
  <view wx:if="{{expanded && selected}}" class="expanded-selection between"><view><text class="edit-title">{{selected.label}} · 第 {{selected.startLabel}} 拍</text><view class="caption">时值 {{selected.durationLabel}} 拍{{hasOverlaps ? ' · 重叠，调整后才能保存' : ''}}</view></view><button class="text-button" bindtap="editSelected">数值精调 ↗</button></view>
  </view>
  <view wx:if="{{hasOverlaps}}" id="overlap-warning" class="overlap-warning"><view>有 {{overlapCount}} 个音符在时间上重叠</view><text>可继续拖动和试听，调整后才能保存或导出。</text><text wx:if="{{draftState}}">{{draftState}}</text></view>

  <view id="note-editor" class="note-edit card" wx:if="{{selected}}"><view class="between"><view class="row"><view class="selected-badge">{{selected.label}}</view><view><view class="edit-title">正在编辑第 {{selected.number}} 个音符</view><view class="caption">第 {{selected.startLabel}} 拍开始</view></view></view><button class="text-button" bindtap="previewNote">听这个音 ↗</button></view>
    <view class="control-row"><text class="control-label">起始拍</text><view class="start-controls"><button id="start-earlier" class="step-button" data-delta="-0.125" bindtap="nudgeStart">−</button><input id="start-input" type="digit" value="{{selected.startLabel}}" bindconfirm="startInput" bindblur="startInput" /><text class="unit">拍</text><button id="start-later" class="step-button" data-delta="0.125" bindtap="nudgeStart">＋</button></view></view>
    <view class="position-hint">{{selected.gapBefore > 0 ? '前方留白 ' + selected.gapBefore + ' 拍，可移动起点调整' : '起始拍从 1 开始，其他音符保持原位'}}</view>
    <view class="control-row"><text class="control-label">音高</text><view class="pitch-controls"><button id="pitch-down" class="step-button" data-delta="-1" bindtap="shiftPitch">−</button><view class="pitch-value">{{selected.label}}<text>MIDI {{selected.midi}}</text></view><button id="pitch-up" class="step-button" data-delta="1" bindtap="shiftPitch">＋</button></view></view>
    <view class="control-row"><text class="control-label">时值</text><view class="duration-controls"><button class="step-button" data-delta="-0.125" bindtap="nudgeDuration">−</button><input id="duration-input" type="digit" value="{{selected.durationLabel}}" bindconfirm="durationInput" bindblur="durationInput" /><text class="unit">拍</text><button class="step-button" data-delta="0.125" bindtap="nudgeDuration">＋</button></view></view>
    <view class="duration-presets"><button data-value="0.25" bindtap="setDuration" class="{{selected.duration === 0.25 ? 'chosen' : ''}}">¼ 拍</button><button data-value="0.5" bindtap="setDuration" class="{{selected.duration === 0.5 ? 'chosen' : ''}}">½ 拍</button><button data-value="1" bindtap="setDuration" class="{{selected.duration === 1 ? 'chosen' : ''}}">1 拍</button><button data-value="2" bindtap="setDuration" class="{{selected.duration === 2 ? 'chosen' : ''}}">2 拍</button><button data-value="4" bindtap="setDuration" class="{{selected.duration === 4 ? 'chosen' : ''}}">4 拍</button></view>
    <view class="note-edit-footer between"><text>移动和改时值只影响当前音符</text><button id="delete-note" class="delete-note" bindtap="deleteNote" disabled="{{notes.length <= 1}}">删除音符</button></view>
  </view>

  <view class="section-heading"><text class="section-title">再调整一点</text><button id="add-note" class="text-button" bindtap="addNote">＋ 添加音符</button></view>
  <view class="global-controls card"><view class="global-actions"><button data-delta="-12" bindtap="shiftAll">低八度</button><button data-delta="12" bindtap="shiftAll">高八度</button><button id="quantize-button" bindtap="quantize">对齐节奏</button></view><view class="caption small-hint">对齐节奏会吸附到 1/4 拍。点右上角 BPM 数字可改速度；识别初始为 100 BPM。</view></view>

  <view class="section-heading"><text class="section-title">音符清单</text><text class="caption">点一行，编辑这个音符 ↗</text></view>
  <view class="list-instructions">点选任意一行，会自动跳到音符编辑卡片。<view>起始拍改位置和留白；音高 ± 改半音；时值改长短。<view>数字框可直接输入，改好后点击空白处生效。</view></view></view>
  <view class="note-list card"><view class="note-list-header"><text>序号</text><text>音高</text><text>起始拍</text><text>时值</text></view><scroll-view scroll-y class="note-list-scroll"><view wx:for="{{notes}}" wx:key="id" class="note-list-row {{item.selected ? 'active-row' : ''}} {{item.overlapping ? 'overlap-row' : ''}}" data-id="{{item.id}}" bindtap="selectFromList"><text>{{item.number}}<text wx:if="{{item.overlapping}}" class="overlap-tag"> 重叠</text><text wx:elif="{{item.uncertain}}" class="uncertain-dot"> ·</text></text><text>{{item.label}}</text><text>{{item.startLabel}}</text><text>{{item.durationLabel}} 拍</text></view></scroll-view></view>
  <view class="editor-tip">哼唱中的滑音和颤音可能需要手动修正。<view>同一个音高连续哼唱时，分音可能需要自行补充。</view></view>
  <button id="export-midi" class="primary export-button {{hasOverlaps ? 'export-conflict' : ''}}" bindtap="exportMidi" loading="{{exporting}}">{{hasOverlaps ? '解决重叠后导出 MIDI' : '导出 MIDI'}} <text>↗</text></button><view class="export-caption">{{hasOverlaps ? '重叠的音符已标出，你可以继续调整或试听。' : '把这段灵感，接着写成一首歌。'}}</view>
  <button id="export-audio" class="secondary audio-export-button" bindtap="chooseAudio" loading="{{audioPreparing}}" disabled="{{audioPreparing}}">分享音频文件 ↗</button><view class="export-caption">分享当前旋律的 WAV 音频{{source ? '，或发送原始哼唱。' : '，保存后可用播放器试听。'}}</view>
</view>
<view wx:if="{{exportVisible}}" class="overlay"><view class="dialog"><view class="export-file-icon">♪</view><view class="dialog-title">旋律已经装进 MIDI 了</view><view class="file-name">{{exportedName}}</view><view class="caption">标准 MIDI · {{exportedSize}} · {{bpm}} BPM</view><view class="dialog-copy export-copy">发送到文件传输助手，就能在电脑上导入 Cubase、Logic 等编曲软件，继续完成你的作品。</view><view wx:if="{{isDevtools}}" class="dev-hint">开发者工具已生成文件；文件转发需要在手机微信中验证。</view><button id="share-midi" class="primary" disabled="{{isDevtools}}" bindtap="shareMidi">发送到微信</button><button id="close-export" class="text-button" bindtap="closeExport">完成</button></view></view>
<view wx:if="{{audioVisible && audioInfo}}" class="overlay"><view class="dialog"><view class="export-file-icon">♫</view><view class="dialog-title">音频文件准备好了</view><view class="file-name">{{audioInfo.name}}</view><view class="caption">WAV 音频 · {{audioInfo.duration}} 秒 · {{audioInfo.size}}</view><view class="dialog-copy export-copy">{{audioInfo.kind === 'original' ? '这是最初录下的哼唱，保持录音原速。' : '这是当前音符按 ' + audioInfo.bpm + ' BPM、' + audioInfo.tone + '合成的旋律。'}}<view>发送给微信好友或文件传输助手，保存后可在支持 WAV 的播放器中试听。</view></view><view wx:if="{{isDevtools}}" class="dev-hint">音频文件已生成；发送到微信需要在手机上操作。</view><button id="share-audio" class="primary" disabled="{{isDevtools || audioSharing}}" loading="{{audioSharing}}" bindtap="shareAudio">发送到微信</button><button id="close-audio" class="text-button" disabled="{{audioSharing}}" bindtap="closeAudio">完成</button></view></view>
