page {
  --page: #f5f6f3;
  --surface: #ffffff;
  --ink: #18221c;
  --muted: #59655e;
  --line: #dce3de;
  --panel: #e6eee8;
  --accent: #255241;
  --on-accent: #ffffff;
  --note: #c7dbcd;
  --error: #a53734;
  --error-bg: #f7e4e0;
  background: var(--page);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, system-ui, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
}
@media (prefers-color-scheme: dark) {
  page {
    --page: #171d1b;
    --surface: #202825;
    --ink: #edf2ef;
    --muted: #a6b5ad;
    --line: #384641;
    --panel: #293a31;
    --accent: #aed8bf;
    --on-accent: #142a20;
    --note: #466c57;
    --error: #ffb8b1;
    --error-bg: #542f2d;
  }
}
view, button, input, text, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; min-height: 44px; border-radius: 24rpx; font-size: 28rpx; line-height: 1.35; color: var(--ink); background: transparent; font-weight: 500; }
button::after { border: 0; }
button[disabled] { opacity: .42; }
button.button-hover { opacity: .75; }
.page { padding: 24rpx 36rpx 54rpx; padding-bottom: calc(54rpx + env(safe-area-inset-bottom)); }
.page-title { font-size: 60rpx; line-height: 1.18; font-weight: 700; letter-spacing: -1.6rpx; }
.tabular, .bpm-control { font-variant-numeric: tabular-nums; }
.caption { font-size: 25rpx; color: var(--muted); line-height: 1.5; }
.muted { color: var(--muted); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 34rpx 0 18rpx; }
.section-title { font-size: 32rpx; font-weight: 650; }
.text-button { display: inline-flex; align-items: center; justify-content: center; background: transparent; font-size: 27rpx; color: var(--accent); padding: 0 10rpx; white-space: nowrap; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; padding: 16rpx 26rpx; }
.primary { background: var(--accent); color: var(--on-accent); font-weight: 600; }
.secondary { background: var(--panel); color: var(--accent); }
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 28rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.pill { display: inline-flex; align-items: center; background: var(--panel); color: var(--accent); padding: 7rpx 16rpx; border-radius: 30rpx; font-size: 23rpx; }
.overlay { position: fixed; inset: 0; background: rgba(16,22,18,.44); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 36rpx; }
.sheet-overlay { align-items: flex-end; padding: 0; }
.dialog { padding: 34rpx 32rpx 24rpx; background: var(--surface); width: 100%; border-radius: 34rpx; }
.sheet { padding-bottom: calc(22rpx + env(safe-area-inset-bottom)); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.dialog-title { font-size: 36rpx; font-weight: 680; }
.dialog-copy { font-size: 28rpx; color: var(--muted); line-height: 1.55; margin: 16rpx 0; }
.dialog .primary, .dialog .secondary { width: 100%; margin-top: 14rpx; }
.dialog-action { width: 100%; margin-top: 10rpx; }
.empty { padding: 32rpx 18rpx; color: var(--muted); font-size: 27rpx; }
.hairline { border-top: 1rpx solid var(--line); }
